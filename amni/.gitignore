# Real environment files stay local. Commit sanitized examples only.
.env
.env.*
*.env
*.env.*
.envrc
.envrc.local
!.env.example
!.env.*.example
!*.env.example

# Credentials and local account configuration
.aws/
.ssh/
.secrets/
secrets/
credentials/
.credentials
credentials.json
credentials.*.json
*-credentials.json
service-account*.json
*-service-account.json
.netrc
.npmrc
.pypirc
.openai/credentials*
.openai/*.token

